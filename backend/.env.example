# ===== App =====
APP_NAME=CryptoQuant
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=please-change-me-in-prod
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ===== PostgreSQL / TimescaleDB / pgvector =====
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=cryptoquant_db
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# DATABASE_URL is auto-computed from above in core/config.py

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=8
REDIS_PASSWORD=
# REDIS_URL is auto-computed from above in core/config.py

# ===== Binance =====
BA_BASE_URL=https://api.binance.com
KLINE_ENDPOINT=/api/v3/klines
BA_RATE_LIMIT_PER_MIN=4500
BA_REQUEST_TIMEOUT=10.0
BA_PROXY_URL=

# ===== LLM =====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini

# ===== Job Queues =====
JOB_QUEUE_DATA=data
JOB_QUEUE_COMPUTE=compute
JOB_QUEUE_LLM=llm
JOB_QUEUE_SIM=sim
JOB_QUEUE_ANALYTICS=analytics
